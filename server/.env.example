# Copy to server/.env for local development (matches deploy/docker-compose.dev.yml)
DATABASE_URL=postgres://punkte:punkte-dev@127.0.0.1:5432/punkte
BIND_ADDR=127.0.0.1:8080
# Development only. Production: openssl rand -base64 48
JWT_SECRET=dev-only-secret-dev-only-secret-dev-only-secret
RUST_LOG=punkte_server=debug,tower_http=debug
# Optional: "Mit Google anmelden", OAuth web client ID (docs/GOOGLE-LOGIN.md)
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Desktop app: the "Desktop" OAuth client (both or none)
# GOOGLE_DESKTOP_CLIENT_ID=1234567890-def.apps.googleusercontent.com
# GOOGLE_DESKTOP_CLIENT_SECRET=
