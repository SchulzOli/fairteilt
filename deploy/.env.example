# Reverse proxy. Default: a central proxy on this server (Caddy, nginx, ...) forwards
# https://<domain> to 127.0.0.1:API_PORT. Server for Fairteilt alone: COMPOSE_PROFILES=caddy
# starts the bundled Caddy on 80/443 for DOMAIN (DNS A/AAAA record must point here).
API_PORT=8791
COMPOSE_PROFILES=
DOMAIN=fairteilt.oli-tech.eu
# Long random password, hex only (it goes into a URL, so no / or +): openssl rand -hex 32
POSTGRES_PASSWORD=
# Secret for signing access tokens, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Rate limiting uses X-Forwarded-For from Caddy (set in docker-compose.yml): TRUST_PROXY=1
# Optional: push over Firebase Cloud Messaging. Service account JSON in deploy/secrets/ (see README)
# FCM_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
# Optional: "Mit Google anmelden", the OAuth web client ID (docs/GOOGLE-LOGIN.md). Not secret.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Prebuilt image from CI (workflow Server-Image) instead of building Rust on the server.
# update.sh pulls it. Tags: main, sha-<commit>, versions from v* tags. Remove to build here
API_IMAGE=ghcr.io/schulzoli/fairteilt-server:main
# RUST_LOG=punkte_server=debug,tower_http=info
