# Public host name of the API (DNS A/AAAA record must point to this server)
DOMAIN=fairteilt.oli-tech.eu
# Long random password: openssl rand -base64 32
POSTGRES_PASSWORD=
# Secret for signing access tokens, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
